{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "physics",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "COMMENTS_DB"
    }
  ]
}
