{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "physics",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "physics-comments",
      "database_id": "c5029797-1d1a-471a-ac80-54c55fc90d69"
    }
  ]
}
